import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_motor_diagram(L=0.2, beta_deg=45):
    # Setup Figure
    fig, ax = plt.subplots(figsize=(10, 10))
    ax.set_aspect('equal')
    ax.set_title(f"Quadrotor Motor Layout (X-up / ENU)")
    
    # Define colors
    arm_color = '#7f8c8d'  # Gray
    body_color = '#34495e' # Dark Gray
    cw_color = '#e74c3c'   # Red
    ccw_color = '#2ecc71'  # Green
    font_size_main = 14
    motor_radius = 0.03

    # Define Axes Range
    range_limit = L + 0.1
    ax.set_xlim(-range_limit, range_limit)
    ax.set_ylim(-range_limit, range_limit)

    # Convert beta to radians
    beta = np.radians(beta_deg)

    # 1. Define Motor Positions relative to Center (0,0)
    # The layout is (1): Front-Right, (2): Rear-Left, (3): Front-Left, (4): Rear-Right
    # The ASCII indicates a classic diagonal 'X' configuration.
    motors = {
        '1': {'pos': np.array([ L*np.cos(beta), -L*np.sin(beta)]), 'dir': 'CW'},
        '2': {'pos': np.array([-L*np.cos(beta),  L*np.sin(beta)]), 'dir': 'CW'},
        '3': {'pos': np.array([ L*np.cos(beta),  L*np.sin(beta)]), 'dir': 'CCW'},
        '4': {'pos': np.array([-L*np.cos(beta), -L*np.sin(beta)]), 'dir': 'CCW'},
    }

    # --- Draw Full Axes Lines ---
    axis_len = L + 0.04

    # b1 axis: Full horizontal line, but arrow only on the right
    ax.plot([-axis_len, axis_len], [0, 0], color='black', lw=1.5, zorder=1)
    ax.arrow(axis_len - 0.01, 0, 0.01, 0, head_width=0.015, head_length=0.03, fc='k', ec='k')
    ax.text(axis_len + 0.04, 0, 'b1', fontsize=12, fontweight='bold', va='center')

    # b2 axis: Full vertical line, but arrow only on the top
    ax.plot([0, 0], [-axis_len, axis_len], color='black', lw=1.5, zorder=1)
    ax.arrow(0, axis_len - 0.01, 0, 0.01, head_width=0.015, head_length=0.03, fc='k', ec='k')
    ax.text(0, axis_len + 0.04, 'b2', fontsize=12, fontweight='bold', ha='center')
    
    # Center Point (+)
    ax.plot(0, 0, 'k+', markersize=15, mew=2)

    # 3. Draw Arms (Lines from Center to Motor)
    # Arm 1-2 (diagonal)
    ax.plot([motors['1']['pos'][0], motors['2']['pos'][0]], 
            [motors['1']['pos'][1], motors['2']['pos'][1]], 
            color=arm_color, lw=3, label='Arm')
    # Arm 3-4 (diagonal)
    ax.plot([motors['3']['pos'][0], motors['4']['pos'][0]], 
            [motors['3']['pos'][1], motors['4']['pos'][1]], 
            color=arm_color, lw=3)

    # 4. Draw Motors and Rotation Arrows
    arrow_size = 0.02
    arrow_width = 0.005

    for m_id, data in motors.items():
        x, y = data['pos']
        m_dir = data['dir']
        m_color = cw_color if m_dir == 'CW' else ccw_color

        # a. Motor Circle
        circle = patches.Circle((x, y), motor_radius, edgecolor='k', facecolor='white', lw=1.5, zorder=5)
        ax.add_patch(circle)

        # b. Motor Number (Center)
        ax.text(x, y, m_id, fontsize=font_size_main, color='k', va='center', ha='center', fontweight='bold', zorder=6)

        # c. Rotation Arrows (Outside the Circle)
        # We draw a small arc to visualize rotation
        arc_radius = motor_radius + 0.02
        if m_dir == 'CW':
            # Arc from -45 to -225 (visualizing top-down CW)
            arc = patches.Arc((x, y), arc_radius*2, arc_radius*2, angle=0, theta1=-225, theta2=-45, color=m_color, lw=2, zorder=4)
            # Add small arrow head at the end
            arrow_x = x + arc_radius * np.cos(np.radians(-45))
            arrow_y = y + arc_radius * np.sin(np.radians(-45))
            ax.arrow(arrow_x, arrow_y, 0.005, 0.005, color=m_color, head_width=0.01, head_length=0.01, zorder=7)
            
            # Label CW
            ax.text(x, y - (arc_radius + 0.02), 'CW', color=m_color, fontsize=10, fontweight='bold', va='center', ha='center')
        else:
            # Arc from 45 to 225 (visualizing top-down CCW)
            arc = patches.Arc((x, y), arc_radius*2, arc_radius*2, angle=0, theta1=45, theta2=225, color=m_color, lw=2, zorder=4)
            # Add small arrow head at the end
            arrow_x = x + arc_radius * np.cos(np.radians(45))
            arrow_y = y + arc_radius * np.sin(np.radians(45))
            ax.arrow(arrow_x, arrow_y, 0.005, -0.005, color=m_color, head_width=0.01, head_length=0.01, zorder=7)
            
            # Label CCW
            ax.text(x, y + (arc_radius + 0.02), 'CCW', color=m_color, fontsize=10, fontweight='bold', va='center', ha='center')
        
        ax.add_patch(arc)

    # 5. Draw Angle Beta (Arc from b1 to Arm Line)
    # This arc goes from the X-axis (0 deg) to the Arm 1 line (-45 deg or -beta)
    # Because Beta is defined positively but the arm is below the axis, theta1=-beta, theta2=0
    arc_beta1 = patches.Arc((0, 0), 0.15, 0.15, theta1=0, theta2=beta_deg, color='blue', lw=2)
    ax.add_patch(arc_beta1)
    l1_angle = np.radians(beta_deg / 2)
    ax.text(0.09 * np.cos(l1_angle), 0.09 * np.sin(l1_angle), r'$\beta$', color='blue', fontsize=15)

    # 2. Beta in Quadrant 2 (between negative b1 and Motor 2)
    # Starts at 180 - beta_deg and ends at 180
    arc_beta2 = patches.Arc((0, 0), 0.15, 0.15, theta1=180-beta_deg, theta2=180, color='blue', lw=2)
    ax.add_patch(arc_beta2)
    l2_angle = np.radians(180 - beta_deg / 2)
    ax.text(0.09 * np.cos(l2_angle), 0.09 * np.sin(l2_angle), r'$\beta$', 
            color='blue', fontsize=15, ha='right')

    # Formatting
    # Hide the default spines (axis borders)
    ax.set_axis_off()
    
    # Hide standard tick labels, as we have custom ones
    ax.set_xticks([])
    ax.set_yticks([])
    
    plt.tight_layout()
    plt.show()

# Execute the function
draw_motor_diagram(L=0.2, beta_deg=45)